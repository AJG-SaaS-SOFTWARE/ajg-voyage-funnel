NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_PUBLISHED_ROOT_DOMAIN=voyage.ajgsolutionsgroup.com

# Server-only AI writing assistant. Never expose this key with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=sk-your-server-key
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Server-only billing notification worker. Never expose these values with NEXT_PUBLIC_.
# Preferred current server credential. Keep server-only.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy compatibility during migration; remove once SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_server_key
RESEND_FROM_EMAIL=AJG Builder <notifications@your-verified-domain.example>
CRON_SECRET=generate-a-long-random-secret
NEXT_PUBLIC_APP_URL=https://ajg-site-builder.vercel.app

# Stripe Billing — server-only. Prefer a restricted key (rk_) with the minimum
# permissions required for Checkout, Customers/Subscriptions and Billing Portal.
STRIPE_RESTRICTED_KEY=rk_test_your_restricted_key
# Optional fallback during setup only; prefer STRIPE_RESTRICTED_KEY above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Checkout remains closed unless this explicit server-side switch is true.
AJG_BILLING_CHECKOUT_ENABLED=false
# BUILD / RUN / GROW Stripe catalogue. Keep test/sandbox IDs in non-live environments.
STRIPE_ESSENTIAL_MONTHLY_PRICE_ID=price_your_essential_monthly_price
STRIPE_ESSENTIAL_ANNUAL_PRICE_ID=price_your_essential_annual_price
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_your_growth_monthly_price
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_your_growth_annual_price
STRIPE_AI_LAUNCH_PRICE_ID=price_your_ai_launch_one_time_price
# Number of successful full-site BUILD operations included in one AI Launch purchase.
AJG_AI_LAUNCH_OPERATIONS=4
# Subscription trial is independent from BUILD. Keep 0 until the new trial strategy is validated.
AJG_SUBSCRIPTION_TRIAL_DAYS=0
# Pin Customer Portal behavior instead of relying on Stripe account defaults.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_your_sandbox_portal_configuration
# Seller identity used by AJG Builder legal pages. Do not enable LEGAL_READY while required fields are blank.
AJG_LEGAL_NAME=
AJG_TRADE_NAME=AJG Site Builder
AJG_LEGAL_FORM=
AJG_SHARE_CAPITAL=
AJG_LEGAL_ADDRESS=
AJG_LEGAL_EMAIL=
AJG_LEGAL_PHONE=
AJG_SIREN=
AJG_REGISTRATION=
AJG_VAT_NUMBER=
AJG_PUBLICATION_DIRECTOR=
AJG_PRIVACY_EMAIL=
AJG_DPO_CONTACT=
# Keep consumer sales disabled until withdrawal/cancellation/mediation flows are legally complete.
AJG_COMMERCIAL_CONSUMER_SALES_ENABLED=false
AJG_CONSUMER_MEDIATOR_NAME=
AJG_CONSUMER_MEDIATOR_ADDRESS=
AJG_CONSUMER_MEDIATOR_URL=
# Initial commercial market: B2B only. Consumer sales remain separately gated.
AJG_COMMERCIAL_MARKET=B2B
# Stripe Product Tax Code: Software as a Service (SaaS) - Business Use.
AJG_STRIPE_TAX_CODE=txcd_10103001
# Tax collection is a separate switch. Never enable until VAT regime/registrations are confirmed.
AJG_STRIPE_TAX_ENABLED=false
# Allowed launch values: unconfirmed | franchise_base | vat_registered.
AJG_VAT_REGIME=unconfirmed
# Human/compliance gates. Keep false until the corresponding launch review is complete.
AJG_COMMERCIAL_LEGAL_READY=false
AJG_COMMERCIAL_TAX_READY=false

# Server-only token for custom-domain provisioning. Scope it to the AJG team/project.
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=prj_RUtVL1fXzOqY8dHetb6U2dp07Ygn
VERCEL_TEAM_ID=team_T1xBMzY6HJCAkUStrmkUgj60

# External media backup — Vercel Blob private store.
# BLOB_STORE_ID is populated by Vercel when the private Blob store is connected
# to this project. Production uses Vercel OIDC; do not create a long-lived
# BLOB_READ_WRITE_TOKEN unless a non-Vercel local backup test explicitly needs one.
BLOB_STORE_ID=
AJG_STORAGE_BACKUP_RETENTION_DAYS=35


# AJG Business & Infrastructure Cockpit — private aggregate reporting.
# Configure the same long random bearer token on the Builder and Cockpit servers.
AJG_COCKPIT_REPORTING_TOKEN=
